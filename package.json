{
  "name": "murmr",
  "version": "1.0.0",
  "author": "calebjebadurai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CalebJebadurai/murmur.git"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/bun": "latest",
    "lefthook": "^1.6.0",
    "typescript": "^5.7.0"
  },
  "main": "dist/index.js",
  "types": "src/index.ts",
  "bin": {
    "murmr": "dist/cli.js",
    "mrmr": "dist/cli.js"
  },
  "bugs": {
    "url": "https://github.com/CalebJebadurai/murmur/issues"
  },
  "description": "Tool-agnostic, packageable multi-agent + subagent framework. Generic agents, on-demand subagents, knowledge from skills/instructions, codebase auto-init.",
  "engines": {
    "bun": ">=1.4.0"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/CalebJebadurai/murmur#readme",
  "keywords": [
    "ai-agents",
    "subagents",
    "multi-agent",
    "skills",
    "instructions",
    "copilot",
    "claude-code",
    "goose",
    "cursor",
    "acp",
    "scaffolding",
    "cli"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/cli.ts src/index.ts --target bun --outdir dist --minify && chmod +x dist/cli.js",
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "externalization": "bun run scripts/check-externalization.ts",
    "agents": "bun run src/cli.ts compile",
    "agents:check": "bun run src/cli.ts doctor",
    "prepare": "lefthook install || true",
    "prepublishOnly": "bun run build"
  },
  "type": "module"
}
